# ─── App ───
APP_NAME=Plataforma
ENV=development
DEBUG=true

# ─── Base de datos (Postgres) ───
DATABASE_URL=postgresql+psycopg2://plataforma:plataforma@localhost:5433/plataforma

# ─── Redis (cola de jobs / cache) ───
REDIS_URL=redis://localhost:6379/0

# ─── Auth0 (identidad única — se usa desde la Fase 1) ───
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ─── Storage ───
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=plataforma
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Cifrado en reposo (Fernet) — genera una propia en producción ───
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=v752OvalSjw6Lmo-cgJb12Kg7tGQ0qcIkdmnOMzcWj4=

# ─── Jobs ───
MAX_CONCURRENT_JOBS=3

# ─── CORS (orígenes del frontend, formato JSON) ───
CORS_ORIGINS=["http://localhost:5173"]
