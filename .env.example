# ─── App ───
APP_NAME=Plataforma
ENV=development
DEBUG=true

# ─── Base de datos (Postgres) ───
# Local (docker compose). En producción (Neon) usa el pooled connection string
# con SSL, p. ej.:
#   postgresql+psycopg2://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql+psycopg2://plataforma:plataforma@localhost:5433/plataforma

# ─── Auth0 (identidad única) ───
# Ver SETUP-AUTH0.md para crear el tenant y obtener estos valores.
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.plataforma
# SPA (para el email de establecer contraseña) y Management API (crear usuarios).
AUTH0_SPA_CLIENT_ID=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication

# ─── Storage ───
# STORAGE_BACKEND: "local" (disco, dev) o "s3" (AWS S3 / Cloudflare R2 / MinIO).
# Las variables S3_* solo se usan cuando STORAGE_BACKEND=s3.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# Para MinIO local: STORAGE_BACKEND=s3 y descomenta el compose (minio en :9000).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=plataforma
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Cifrado en reposo (Fernet) — OBLIGATORIO en producción ───
# En producción la app NO arranca con este valor de dev; genera una propia:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=v752OvalSjw6Lmo-cgJb12Kg7tGQ0qcIkdmnOMzcWj4=

# ─── CORS (orígenes del frontend, formato JSON) ───
CORS_ORIGINS=["http://localhost:5173"]
