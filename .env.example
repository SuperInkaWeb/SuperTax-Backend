# ─── App ───
APP_NAME=Plataforma
ENV=development
DEBUG=true

# ─── Base de datos (Postgres) ───
DATABASE_URL=postgresql+psycopg2://plataforma:plataforma@localhost:5432/plataforma

# ─── Redis (cola de jobs / cache) ───
REDIS_URL=redis://localhost:6379/0

# ─── Auth0 (identidad única — se usa desde la Fase 1) ───
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ─── Storage S3 / MinIO (fases posteriores) ───
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=plataforma
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── CORS (orígenes del frontend, formato JSON) ───
CORS_ORIGINS=["http://localhost:5173"]
